<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TakeHomeAssessment.ViewModels"
             x:Class="TakeHomeAssessment.Views.QuotesPage"
             Title="Quotes">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Get Quote Button -->
            <Button Text="Get Quote"
                    Command="{Binding GetQuoteCommand}">
                <Button.BackgroundColor>
                    <OnPlatform x:TypeArguments="Color">
                        <On Platform="iOS" Value="LightSkyBlue" />
                        <On Platform="Android" Value="LightGreen" />
                        <On Platform="WinUI" Value="LightCoral" />
                        <On Platform="MacCatalyst" Value="Plum" />
                    </OnPlatform>
                </Button.BackgroundColor>
            </Button>

            <!-- Label to display the quote -->
            <Label Text="{Binding QuoteText}"
                   FontSize="18"
                   TextColor="{Binding QuoteTextColor}"
                   FontAttributes="{Binding QuoteFontAttributes}"
                   TextDecorations="{Binding QuoteTextDecorations}"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding QuoteAuthor}"
                   FontSize="18"
                   TextColor="Black"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
